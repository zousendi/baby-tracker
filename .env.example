# Set the same secret in hosted Sites settings. Never expose it to client code.
ADMIN_KEY=
# Web Push: configure these as hosted runtime secrets through Sites, not in source.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=
PUSH_JOB_KEY=
# Set true only after the server scheduler has been configured and verified.
PUSH_REMINDERS_ENABLED=false
